{
    "type": "AdaptiveCard",
    "version": "1.5",
    "body": [
        {
            "type": "Container",
            "style": "emphasis",
            "items": [
                {
                    "type": "ColumnSet",
                    "columns": [
                        {
                            "type": "Column",
                            "width": "auto",
                            "items": [
                                {
                                    "type": "Image",
                                    "url": "https://img.icons8.com/color/48/microsoft-teams-2019.png",
                                    "size": "Small",
                                    "style": "Person"
                                }
                            ]
                        },
                        {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "Meeting Intelligence Report",
                                    "weight": "Bolder",
                                    "size": "Large",
                                    "color": "Accent"
                                },
                                {
                                    "type": "TextBlock",
                                    "text": "${meeting_subject}",
                                    "weight": "Bolder",
                                    "size": "Medium",
                                    "spacing": "None"
                                }
                            ],
                            "verticalContentAlignment": "Center"
                        }
                    ]
                }
            ]
        },
        {
            "type": "Container",
            "items": [
                {
                    "type": "TextBlock",
                    "text": "Exec Summary",
                    "weight": "Bolder",
                    "size": "Medium",
                    "color": "Accent"
                },
                {
                    "type": "TextBlock",
                    "text": "${summary}",
                    "wrap": true
                }
            ]
        },
        {
            "type": "Container",
            "spacing": "Medium",
            "items": [
                {
                    "type": "TextBlock",
                    "text": "✅ Action Items",
                    "weight": "Bolder",
                    "size": "Medium"
                },
                {
                    "type": "FactSet",
                    "facts": "${tasks}"
                }
            ]
        },
        {
            "type": "Container",
            "style": "good",
            "items": [
                {
                    "type": "TextBlock",
                    "text": "🚀 Dynamics 365 Updates Proposed",
                    "weight": "Bolder",
                    "size": "Medium"
                },
                {
                    "type": "FactSet",
                    "facts": "${crm_updates}"
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Action.OpenUrl",
            "title": "View in Dynamics 365",
            "url": "${crm_link}"
        },
        {
            "type": "Action.Submit",
            "title": "Approve Updates",
            "data": {
                "action": "approve_crm_update",
                "meeting_id": "${meeting_id}"
            }
        }
    ]
}