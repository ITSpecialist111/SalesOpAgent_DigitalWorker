# === Azure Entra ID ===
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# === Agent 365 ===
MCP_PLATFORM_ENDPOINT=https://agent365.svc.cloud.microsoft
MCP_PLATFORM_AUTHENTICATION_SCOPE=ea9ffc3e-8a23-4a7d-836d-234d7c7565c1/.default
AGENTIC_APP_ID=
AGENTIC_USER_ID=
USE_AGENTIC_AUTH=true
AUTH_HANDLER_NAME=AGENTIC

# === LLM Provider ===
# Options: azure_openai, anthropic
LLM_PROVIDER=azure_openai

# Azure OpenAI (used when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Anthropic Claude (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# === Salesforce (optional - stubbed by default) ===
SALESFORCE_ENABLED=false
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_DOMAIN=login

# === Server ===
PORT=3978
LOG_LEVEL=INFO

# === Observability ===
ENABLE_OBSERVABILITY=true
OBSERVABILITY_SERVICE_NAME=salesops-bot
